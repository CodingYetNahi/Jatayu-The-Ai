# Public URL of your independently deployed secure adapter. Never put an OmniRoute key here.
VITE_API_BASE_URL=http://localhost:8787

# Worker-only secrets (set with `wrangler secret put`, not in frontend builds)
OMNIROUTE_BASE_URL=http://localhost:8080
OMNIROUTE_API_KEY=replace-with-a-secret
ALLOWED_ORIGIN=http://localhost:5173
