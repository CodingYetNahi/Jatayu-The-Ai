# Frontend: leave blank for same-origin full-stack deployment.
# For GitHub Pages, set this to the public URL of your deployed Jatayu backend.
VITE_API_BASE_URL=

# Optional Pages base path. The GitHub Pages workflow sets /Jatayu-The-Ai/.
VITE_BASE_PATH=/

# Jatayu full-stack server
JATAYU_PORT=8080

# OmniRoute runtime. If OMNIROUTE_BASE_URL is blank, Jatayu starts the bundled
# OmniRoute npm runtime itself on OMNIROUTE_PORT.
OMNIROUTE_BASE_URL=
OMNIROUTE_PORT=20128
OMNIROUTE_DATA_DIR=.omniroute-data
OMNIROUTE_REQUIRE_API_KEY=false

# Only required when pointing Jatayu at a protected external OmniRoute instance.
OMNIROUTE_API_KEY=

# Recommended fixed secrets for persistent/self-hosted OmniRoute deployments.
# Generate strong random values and keep them out of Git.
JWT_SECRET=
API_KEY_SECRET=

# Legacy Cloudflare Worker adapter settings (optional alternative deployment)
ALLOWED_ORIGIN=http://localhost:5173
